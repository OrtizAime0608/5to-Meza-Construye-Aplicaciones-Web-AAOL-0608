	<head>
	<!-- Informacion que el navegador necesita -->
		<title>Pagina WEB de ejemplo:texto</title>
		<!--Este es el titulo principal de la pagina web-->
		<!-- 'title' permite insertar un titulo que aparecera en la pestaña del navegador -->

	</head>
	<body> 
	<!-- Contenedor principal --> 

		<!--Esta linea es un parrafo , se vizualiza por que los navegadores muestran cualquier texto suelto , mas
		 sin embargo no es correcto pues no se le puede aplicar css-->
		<!-- En esta linea se alinea por defecto a la izquierda y al final tiene un salto de linea -->

		Esta es línea, y a continuación insertamos un salto de línea. <br/> 	<!-- 'br' es un salto de linea -->


		<!-- Esta línea alinea el texto al centro y lo pone una linea abajo del anterior -->
		<center> Esta es otra línea. </center>	<!-- 'center' alinea cualquier elemento al centro -->


		<!-- En esta linea se alinea por defecto a la izquierda y al final tiene un salto de linea -->
		Esta es una línea, y a continuación insertamos un salto de línea.<br/>


		<!-- p sirve para agregar un texto , y aling para alinear el texto -->
		<!-- En este caso el texto se alinea a la izquierda (left) -->
		<p align="left">El texto de este párrafo está alineado a la izquierda (por defecto, si no se indica)</p>


		<!-- En este caso el texto se alinea a el centro (center) -->
		<p align="center"> El texto de este párrafo está alineado al centro </p>


		<!-- En este caso el texto se alinea a la derecha ( right) -->
		<p align="right"> El texto de este párrafo está alineado a la derecha </p>
	</body>
</html>
	
